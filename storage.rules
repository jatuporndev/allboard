rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /players/{uid}/character.json {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 4096 && request.resource.contentType == 'application/json';
    }
    // Reserved for server-managed assets, partitioned by game and room.
    match /games/{game}/rooms/{room}/{asset} {
      allow read, write: if false;
    }
  }
}
